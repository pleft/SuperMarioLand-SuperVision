03:4A77 PlayerJumpDown

; ---- Object/ballistic physics engine (enemies + ridden platforms) ----
; PhysicsParamTable_3375: 2-byte entries per object type; byte0 = accel ($FFC7)
00:3375 PhysicsParamTable_3375
; ObjectPhysics_Integrate: $FFC1=vel, $FFC7=accel(grav), applies to $FFC2; also $C201 if $FFCB set
00:2975 ObjectPhysics_Integrate
00:24D6 ObjectPhysics_InitAccel_24D6
00:24EF ObjectPhysics_Init_24EF
00:2491 EnemyUpdate_2491
; State_30 cutscene: scripted "Mario rises" (dec $C201 every other frame until Y==$58)

; ---- Jump / gravity arc (SOLVED via dynamic trace, see docs/08-player.md) ----
; JumpArcTable: per-frame |dY|, indexed by object's vel-index field (+8).
; 27 bytes; entry $7F = apex marker (switch ascend->descend). $216D..$2187.
00:216D .data:1b
00:216D JumpArcTable
; Bank3_ApplyGravityArc ($490D): generic ballistic mover. Caller sets BC=obj+8
; (vel index), HL=$216D. Walks BC down to obj+7 (state 0/1/2) and obj+1 (Y).
; state1: Y-=table[idx], idx++ ; state2: Y+=table[idx], idx-- ; $7F=apex; idx=$FF=land.
; Called for Mario (BC=$C208) and 4 objects ($C218/$C228/$C238/$C248).

; ---- Level loader ----
; LevelLoader_2442: loads level $FFE4 (0-11) into VRAM/map; called by State_08/State_11
00:2442 .code:3
00:2442 LevelLoader_2442

; ---- Level loader + data (level data is in BANK 2) ----
; LevelColumnStream: per-8px-scroll, builds next 16-tile column into $C0B0
00:2198 LevelColumnStream
; LevelSpawnSeek: seek spawn-list ptr ($D010/11) to current column ($C0AB)
00:245C LevelSpawnSeek
; LevelParamTable: per-level (0-11) param byte -> $D014
00:2436 .data:c
00:2436 LevelParamTable
; LevelSegPtrTable (bank2): per-level -> segment-pointer table (indexed by $FFE5)
02:4000 .data:18
02:4000 LevelSegPtrTable
; LevelSpawnListTable (bank2): per-level -> object spawn list (3-byte: col,type,param)
02:401A .data:18
02:401A LevelSpawnListTable

; SelectWorldBank: world (hi nibble $FFB4) -> data bank ($2000/$FFFD).
; world1->bank2, world2->bank1, world3->bank3, world4->bank1. Then loads level gfx.
00:0D6D SelectWorldBank

; ---- Enemy / object subsystem ----
; EnemyUpdate_2491: per-frame = spawn-check + AI update + collision
; 10 object slots @ $D100 (stride $10, 16 bytes; first 13 -> $FFC0..CC working area)
00:249B ObjectSpawnCheck      ; spawn next list entry when column ($C0AB) reached
00:2648 ObjectAIUpdate        ; loop slots $D100..$D190, run physics+AI script per type
00:2568 ObjectCollision_2568  ; object-vs-player / object handling
00:2676 ObjectPhysicsAndScript; apply physics ($FFC7/C8) + step AI script (PC=$FFC4)
00:2CEB ObjectLoadSlot        ; copy 13-byte slot [HL] -> $FFC0..CC
00:2CFD ObjectSaveSlot        ; copy $FFC0..CC -> slot [HL]
; AIScriptPtrTable: per object-type (~28, $00-$1B) -> movement-script bytecode
00:349E .data:38
00:349E AIScriptPtrTable
; AI movement scripts (bytecode interpreted by ObjectPhysicsAndScript): $3564..~$3790
00:3564 AIScripts_3564

