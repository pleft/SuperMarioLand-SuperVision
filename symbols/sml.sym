; ==== VBlank rendering chain (called from VBlank ISR, in order) ====
; OAMDMARoutineSrc: 10 bytes copied to HRAM $FFB6; DMAs $C000->OAM
00:3F92 OAMDMARoutineSrc
; VBlank_ScrollColumnUpd: draw next BG column from $C0B0 (cursor $FFE9, gate $FFEA)
00:2258 VBlank_ScrollColumnUpd
; VBlank_ProcessVRAMQueue: deferred VRAM tile-write queue (cmd $FFEE)
00:1B86 VBlank_ProcessVRAMQueue
; VBlank_UpdateDisp_DA15: 2-digit BCD $DA15 -> map $9806/$9807
00:1C33 VBlank_UpdateDisp_DA15
00:1C56 UpdateDisp_DA15_inner
; VBlank_DrawScore: BCD score $C0A0..2 -> tiles @ $9820 (gate $FFB1 dirty)
00:3F39 VBlank_DrawScore
00:3F4D DrawScore_inner
; VBlank_UpdateDisp_DA00: 3-digit BCD $DA00..2 -> map $9831..33 (coins?)
00:3D6A VBlank_UpdateDisp_DA00
00:3D7E UpdateDisp_DA00_inner
; VBlank_AnimateTiles: 8-byte tile pattern -> $95D1 every 8 frames
00:2401 VBlank_AnimateTiles

; ==== Input / joypad (bank 3) ====
; ReadJoypad: per-frame. $FF80=held, $FF81=pressed.
; bits: 0=A 1=B 2=Select 3=Start 4=Right 5=Left 6=Up 7=Down
03:47F2 ReadJoypad

; ==== Player (Mario) ====
; Player struct base $C200. $C201=Y, $C202=X, $C203=anim/facing,
; $C207=vert state(0 grnd/fall,1 ascend,2 blocked), $C20A=on-ground flag,
; $C20C=H-accel(0..6)/jump-force seed($30 jump,$20 down), $C20E/$C20F=H speed-table idx/toggle.
; Player_HorizControl: horizontal movement (reads $FF80)
00:1D26 Player_HorizControl
; Player_SpeedTable: horizontal speed curve (indexed by $C20E)
00:1ECE Player_SpeedTable
; Player_CeilingCheck: head/ceiling collision, runs when $C207==1 (ascending)
00:198C Player_CeilingCheck
; Player_FloorCheck: floor collision + constant descent ($C201 += 3/frame), runs when $C207!=1
00:17BC Player_FloorCheck
; Player_LandSnap: align $C201 to tile on landing, set $C207=0 $C20A=1
00:185D Player_LandSnap

