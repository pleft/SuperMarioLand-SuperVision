+    static uint8 xlog[SV_H], ylog[SV_H]; // per-scanline XPOS/YPOS captured during the frame
 
     // Number of iterations = 256 * 256 / m6502_registers.IPeriod
+    // Run a full frame of CPU, CAPTURING the scroll registers (XPOS/YPOS) per scanline as
+    // we go, then render the whole frame at the end using those captures. This supports a
+    // mid-frame XSCROLL change (raster split — e.g. a status bar pinned at the top while the
+    // playfield scrolls) WITHOUT exposing partial frames: the framebuffer is fully composed
+    // before any scanline is drawn, so software sprites high on the screen aren't torn.
+    // A game that sets the scroll once per frame renders identically to the old batch path.
     for (i = 0; i < 256; i++) {
         Run6502(&m6502_registers);
         timer_exec(m6502_registers.IPeriod);
+        if (i < SV_H) {
+            xlog[i] = regs[XPOS];
+            ylog[i] = regs[YPOS];
+        }
     }
 
     if (!skipFrame) {
-        scan   = regs[XPOS] / 4 + regs[YPOS] * 0x30;
-        innerx = regs[XPOS] & 3;
-        size   = regs[XSIZE]; // regs[XSIZE] <= SV_W
+        size = regs[XSIZE]; // regs[XSIZE] <= SV_W
         if (size > SV_W)
             size = SV_W; // 192: Chimera, Matta Blatta, Tennis Pro '92
-
         for (i = 0; i < SV_H; i++) {
